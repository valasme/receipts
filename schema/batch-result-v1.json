{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Receipts batch result, major 1",
  "type": "object",
  "properties": {
    "schema_major": { "const": 1 },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "receipt": { "$ref": "receipt-v1.json" },
          "error": { "type": "string", "minLength": 1 }
        },
        "oneOf": [{ "required": ["receipt"] }, { "required": ["error"] }]
      }
    }
  },
  "required": ["schema_major", "results"]
}
