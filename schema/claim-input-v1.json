{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Receipts saved quotation or batch, major 1",
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "quotation": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 }
      },
      "required": ["path", "quote"]
    },
    "saved_claim": {
      "allOf": [{ "$ref": "#/$defs/quotation" }],
      "properties": {
        "schema_major": { "const": 1 },
        "rev": { "$ref": "#/$defs/commit" }
      },
      "required": ["schema_major", "rev"],
      "unevaluatedProperties": false
    },
    "batch": {
      "type": "object",
      "properties": {
        "schema_major": { "const": 1 },
        "rev": { "$ref": "#/$defs/commit" },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "allOf": [{ "$ref": "#/$defs/quotation" }],
            "unevaluatedProperties": false
          }
        }
      },
      "required": ["schema_major", "rev", "claims"],
      "additionalProperties": false
    }
  },
  "oneOf": [{ "$ref": "#/$defs/saved_claim" }, { "$ref": "#/$defs/batch" }]
}
